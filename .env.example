# API and worker
NODE_ENV=development
PORT=8000
WORKER_PORT=8001
DATABASE_URL=postgresql://theatulgupta@localhost:5432/bazaar

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated browser origins. Mobile native clients are not subject to CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Razorpay test mode keys. Required at boot. Use the fake driver only outside production.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_secret
RAZORPAY_WEBHOOK_SECRET=replace_me_webhook_secret
PAYMENTS_DRIVER=fake

APP_PUBLIC_URL=http://localhost:3000
RESERVATION_TTL_MINUTES=15
RATE_LIMIT_DISABLED=false

# Leave SMTP_HOST empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bazaar <no-reply@bazaar.local>

# Optional OpenTelemetry collector. Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Used by prisma/seed.ts
ADMIN_EMAIL=admin@bazaar.local
ADMIN_PASSWORD=change-me-admin-password

# Mobile (public)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Web server (not exposed to the browser; the Next app proxies API calls)
API_URL=http://localhost:8000
